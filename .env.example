# Copy this file to .env and set all values marked CHANGE_ME.
# The containers run as the host's ubuntu account (UID/GID 1000 by default).
PUID=1000
PGID=1000
TZ=Asia/Ho_Chi_Minh

# Server lifecycle and network
STEAM_BRANCH=evrima
UPDATE_ON_START=true
STEAM_NETWORK_CHECK_URL=https://api.steampowered.com/
UPDATE_MODS=false
PLUGIN_DOWNLOAD_TIMEOUT_SECONDS=300
GAME_PORT=7777
QUERY_PORT=7778
EOS_DEDICATED_SERVER_CLIENT_ID=CHANGE_ME
EOS_DEDICATED_SERVER_CLIENT_SECRET=CHANGE_ME

# Optional integrations. Keep real values only in .env, never commit that file.
ISLEPILOT_API_KEY=CHANGE_ME
ISLEVOICE_SERVER_HASH=CHANGE_ME
DISCORD_WEBHOOK_URL=
MAX_RAM_ALERT=95
RAM_MONITOR_INTERVAL_SECONDS=60

# Backup schedule and retention. Interval is in seconds (1800 = 30 minutes).
BACKUP_INTERVAL_SECONDS=1800
BACKUP_RETENTION_DAYS=5

# Game.ini settings. These values overwrite Game.ini on every server start.
ServerName="[SEA/VN] The Isle Viet Nam TEST"
Discord=discord.gg/CHANGE_ME
MapName=Gateway
MaxPlayerCount=200
bEnableHumans=false
bServerPassword=false
ServerPassword=
bServerWhitelist=true
bEnableGlobalChat=true
bQueueEnabled=true
QueuePort=10000
QueueJoinTimeoutSeconds=300
QueueHeartbeatIntervalSeconds=8
QueueHeartbeatTimeoutSeconds=5
QueueHeartbeatMaxMisses=6
bRconEnabled=true
RconPassword=CHANGE_ME
RconPort=8888
bRandomWeatherEnabled=true
MinWeatherVariationInterval=600
MaxWeatherVariationInterval=900
ServerDayLengthMinutes=45
ServerNightLengthMinutes=16
bSpawnPlants=true
PlantSpawnMultiplier=1
bSpawnAI=true
AISpawnInterval=40
AIDensity=1.2
GrowthMultiplier=1
bEnableDiets=true
bEnableMutations=true
bEnableMigration=true
MaxMigrationTime=5400
SpeciesMigrationTime=10800
bEnableMassMigration=true
MassMigrationTime=43200
MassMigrationDisableTime=7200
bEnablePatrolZones=true
bUseRegionSpawning=true
bUseRegionSpawnCooldown=true
RegionSpawnCooldownTimeSeconds=600
CorpseDecayMultiplier=2
bAllowRecordingReplay=true

# Comma-separated. The startup script writes one AllowedClasses= entry per value.
AdminsSteamIDs=1542124701089009734
WhitelistIDs=
VIPs=
AllowedClasses=Allosaurus,Austroraptor,Beipiaosaurus,Carnotaurus,Ceratosaurus,Deinosuchus,Diabloceratops,Dilophosaurus,Herrerasaurus,Hypsilophodon,Kentrosaurus,Maiasaura,Omniraptor,Pachycephalosaurus,Pteranodon,Stegosaurus,Tenontosaurus,Triceratops,Troodon,Tyrannosaurus